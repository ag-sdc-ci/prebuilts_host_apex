// Prebuilt shadow for system/apex host tools
package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

python_binary_host {
    name: "apexer",
    main: "bin/apexer",
    srcs: ["bin/apexer"],
    libs: [
        "apex_manifest",
        "apexer_wrapper_utils",
    ],
}

python_binary_host {
    name: "deapexer",
    main: "bin/deapexer",
    srcs: ["bin/deapexer"],
    libs: [
        "apex_manifest",
    ],
}

python_binary_host {
    name: "conv_apex_manifest",
    main: "bin/conv_apex_manifest",
    srcs: ["bin/conv_apex_manifest"],
    libs: [
        "apex_manifest",
    ],
}

python_binary_host {
    name: "apex_compression_tool",
    main: "bin/apex_compression_tool",
    srcs: ["bin/apex_compression_tool"],
    libs: [
        "apex_manifest",
    ],
}

python_binary_host {
    name: "apex_elf_checker",
    main: "bin/apex_elf_checker",
    srcs: ["bin/apex_elf_checker"],
}

python_binary_host {
    name: "apexd_host",
    main: "bin/apexd_host",
    srcs: ["bin/apexd_host"],
    libs: [
        "apex_manifest",
    ],
}

python_binary_host {
    name: "apexer_with_DCLA_preprocessing",
    main: "bin/apexer_with_DCLA_preprocessing",
    srcs: ["bin/apexer_with_DCLA_preprocessing"],
    libs: [
        "apexer_wrapper_utils",
    ],
}

python_binary_host {
    name: "apexer_with_trim_preprocessing",
    main: "bin/apexer_with_trim_preprocessing",
    srcs: ["bin/apexer_with_trim_preprocessing"],
    libs: [
        "apexer_wrapper_utils",
    ],
}

python_library_host {
    name: "apex_manifest",
    srcs: [
        "lib/apex_manifest.py",
        "lib/apex_manifest_pb2.py",
        "lib/apex_build_info_pb2.py",
    ],
}

python_library_host {
    name: "apexer_wrapper_utils",
    srcs: [
        "lib/apexer_wrapper_utils.py",
    ],
}
