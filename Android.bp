// Prebuilt shadow for system/apex host tools
package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

sh_binary_host {
    name: "apexer",
    src: "bin/apexer",
}

sh_binary_host {
    name: "deapexer",
    src: "bin/deapexer",
}

sh_binary_host {
    name: "conv_apex_manifest",
    src: "bin/conv_apex_manifest",
}

sh_binary_host {
    name: "apex_compression_tool",
    src: "bin/apex_compression_tool",
}

sh_binary_host {
    name: "apex_elf_checker",
    src: "bin/apex_elf_checker",
}

sh_binary_host {
    name: "apexd_host",
    src: "bin/apexd_host",
}

sh_binary_host {
    name: "apexer_with_DCLA_preprocessing",
    src: "bin/apexer_with_DCLA_preprocessing",
}

sh_binary_host {
    name: "apexer_with_trim_preprocessing",
    src: "bin/apexer_with_trim_preprocessing",
}

python_library_host {
    name: "apex_manifest",
    srcs: [
        "lib/apex_manifest.py",
        "lib/apex_manifest_pb2.py",
        "lib/apex_build_info_pb2.py",
    ],
}

python_library_host {
    name: "apexer_wrapper_utils",
    srcs: [
        "lib/apexer_wrapper_utils.py",
    ],
}
